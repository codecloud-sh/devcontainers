FROM debian:stable-slim
ARG USERNAME={{ username }}
ARG USER_GID=1000
ARG USER_UID=1000

# System packages
# - sudo, zsh, curl, ca-certificates, jq: user environment, dotfiles and post-create.sh
#   (ca-certificates is only a recommendation of curl, skipped by --no-install-recommends)
# - git, openssh-client: Git
# Node or Bun is installed by mise in post-create.sh.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    sudo zsh curl ca-certificates jq \
    git openssh-client \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Non-root user with passwordless sudo
RUN groupadd --gid $USER_GID $USERNAME \
  && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/zsh $USERNAME \
  && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
  && chmod 0440 /etc/sudoers.d/$USERNAME

# Usual umask in every zsh shell (terminals), even when the container exec
# starts them with umask 0000
RUN echo 'umask 022' >> /etc/zsh/zshenv

ENV HOME=/home/$USERNAME

USER $USERNAME

ENV PATH="$HOME/.local/bin:$PATH"

# Mount points of the mise-data, playwright-browsers and devcontainers-gh volumes
# (devcontainer.json), created here so that the volumes belong to the user and not to root.
RUN mkdir -p $HOME/.local/share/mise $HOME/.cache/ms-playwright $HOME/.config/gh
