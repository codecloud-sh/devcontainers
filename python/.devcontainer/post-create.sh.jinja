#!/usr/bin/env bash
set -e

# The container exec may run with umask 0000: without this, everything chezmoi
# clones (oh-my-zsh and its plugins) ends up world-writable and oh-my-zsh
# refuses to load its completions ("Insecure completion-dependent directories").
umask 022

# tmp/ holds the Claude Code configuration, tokens included. A project's .gitignore
# may not cover it: tmp/.gitignore keeps the whole folder out of Git.
mkdir -p tmp
[ -e tmp/.gitignore ] || echo '*' > tmp/.gitignore

echo
echo "================="
echo "Install dot files"
echo "================="
(
  cd                      \
  && mkdir -p .local/bin    \
  && sh -c "$(curl -fsLS get.chezmoi.io/lb)" -- init --apply https://github.com/nicolascochin/dotfiles.git \
  && echo "=> Dot files Installed"
)
echo
echo "================="
echo "Github login"
echo "================="
# gh config lives in the devcontainers-gh volume, shared by every project of this
# machine: only the first container (or a revoked token) asks to log in.
(
  gh auth status >/dev/null 2>&1 || gh auth login
)
echo
echo "================="
echo "mise env"
echo "================="
# Python, uv and the project dependencies are installed by on-create.sh, before
# VS Code connects. Activate mise for this script so it finds the installed tools.
eval "$(mise env)"
echo "=> mise activated."

echo
echo "================="
echo "Node for Claude hooks"
echo "================="
# The caveman hooks run with node and quietly do nothing without it: caveman then
# starts only on /caveman. A Python project usually has no Node: latest Node LTS,
# pinned, as mise's global fallback, kept in the mise-data volume. A Node version
# set by the project (.node-version) still wins wherever it sets one.
if node --version >/dev/null 2>&1; then
  echo "=> Node already available."
elif mise use -g --pin node@lts; then
  echo "=> Node $(node --version) installed as global fallback."
else
  echo "=> Node not installed: caveman starts only with /caveman."
fi

echo
echo "================="
echo "Claude settings..."
echo "================="
# User settings of Claude Code in the container (CLAUDE_CONFIG_DIR, under tmp/):
# no attribution in commits and pull requests. Merged, other settings are kept.
settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"
jq '.attribution = {"commit": "", "pr": "", "sessionUrl": false}' "$settings" > "$settings.tmp" \
  && mv "$settings.tmp" "$settings"
echo "=> Claude settings updated."

echo
echo "================="
echo "rtk init..."
echo "================="
# Global Claude Code hook of rtk (installed by its devcontainer feature), written in
# CLAUDE_CONFIG_DIR next to the settings above. --auto-patch patches settings.json
# without asking. RTK_TELEMETRY_DISABLED=1 skips the telemetry prompt, which can hang
# without a human to answer it: no consent is recorded, so telemetry stays off.
if RTK_TELEMETRY_DISABLED=1 rtk init -g --auto-patch; then
  echo "=> rtk initialized."
else
  echo "=> rtk not initialized."
fi

echo
echo "================="
echo "Install claude plugins..."
echo "================="
claude plugin marketplace add codecloud-sh/claude-plugins --scope project
claude plugin marketplace add JuliusBrussee/caveman

claude plugin install codecloud-core@codecloud --scope project
claude plugin install caveman@caveman --scope project --yes

# Auto-update of the codecloud marketplace: off by default for a third-party marketplace.
# On, Claude Code refreshes it in the background during sessions.
project_settings=.claude/settings.json
jq '.extraKnownMarketplaces.codecloud.autoUpdate = true' "$project_settings" > "$project_settings.tmp" \
  && mv "$project_settings.tmp" "$project_settings"
echo "=> Claude plugins installation completed."
echo "post-create.sh completed."
