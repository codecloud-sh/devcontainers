#!/usr/bin/env bash
set -e

echo
echo "================="
echo "Install dot files"
echo "================="
(
  cd                      \
  && mkdir -p .local/bin    \
  && sudo apt update && sudo apt install -y dialog jq  \
  && {% if git_email %}GIT_EMAIL={{ git_email | quote }} {% endif %}sh -c "$(curl -fsLS get.chezmoi.io/lb)" -- init --apply https://github.com/nicolascochin/dotfiles.git \
  && echo "=> Dot files Installed"
)
echo
echo "================="
echo "Github login"
echo "================="
(
  gh auth status >/dev/null 2>&1 || gh auth login
)
echo
echo "================="
echo "Install ruby and node using mise..."
echo "================="
mise install
eval "$(mise env)" # Activate mise for this script so it finds ruby and node
echo "=> Ruby and node installation completed."

echo
echo "================="
echo "Install claude plugins..."
echo "================="
claude plugin marketplace add anthropics/claude-plugins-official || true
claude plugin marketplace add lucianghinda/superpowers-ruby
claude plugin marketplace add JuliusBrussee/caveman

claude plugin install ruby-lsp@claude-plugins-official --scope project --yes
claude plugin install superpowers@claude-plugins-official --scope project --yes
claude plugin install superpowers-ruby@superpowers-ruby --scope project --yes
claude plugin install caveman@caveman --scope project --yes
echo "=> Claude plugins installation completed."

{%- if stripe %}

echo
echo "================="
echo "Install Stripe CLI..."
echo "================="
curl -fsSL https://cli.stripe.com/install.sh | sh
echo "=> Stripe CLI installation completed."
{%- endif %}

echo
echo "================="
echo "Running setup script..."
echo "================="
if [ -x bin/setup ]; then
  bin/setup --skip-server
else
  echo "=> No bin/setup yet (app not created?), skipping."
fi
echo "post-create.sh completed."
