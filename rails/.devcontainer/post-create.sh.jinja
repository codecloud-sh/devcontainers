#!/usr/bin/env bash
set -e

echo
echo "================="
echo "Install dot files"
echo "================="
(
  cd                      \
  && mkdir -p .local/bin    \
  && sh -c "$(curl -fsLS get.chezmoi.io/lb)" -- init --apply https://github.com/nicolascochin/dotfiles.git \
  && echo "=> Dot files Installed"
)
echo
echo "================="
echo "Github login"
echo "================="
(
  gh auth status >/dev/null 2>&1 || gh auth login
)
echo
echo "================="
echo "Ruby version"
echo "================="
# New project (neither .ruby-version nor Gemfile): offer the latest stable Ruby,
# so that mise install has a Ruby to install. Without a terminal, create it.
if [ ! -e .ruby-version ] && [ ! -e Gemfile ]; then
  latest=$(mise latest ruby 2>/dev/null || true)
  if ! printf '%s' "$latest" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    echo "=> Latest stable Ruby not found, no .ruby-version created."
  else
    answer=y
    if [ -t 0 ]; then
      printf 'No .ruby-version: create it with Ruby %s (latest stable)? [Y/n] ' "$latest"
      read -r answer || answer=y
    fi
    case "$answer" in
      [nN]*) echo "=> No .ruby-version created." ;;
      *) echo "$latest" > .ruby-version && echo "=> .ruby-version created: $latest" ;;
    esac
  fi
else
  echo "=> Ruby version already set by the project."
fi

echo
echo "================="
echo "mise install"
echo "================="
mise install
eval "$(mise env)" # Activate mise for this script so it finds the installed tools
echo "=> mise install completed."

echo
echo "================="
echo "Ruby LSP"
echo "================="
# Language server of the ruby-lsp Claude Code plugin (the VS Code extension manages
# its own copy). Installed in the mise Ruby, kept across rebuilds by the mise-data volume.
if command -v gem >/dev/null 2>&1; then
  gem list -i ruby-lsp >/dev/null 2>&1 || gem install ruby-lsp --no-document
  mise reshim
  echo "=> ruby-lsp installed."
else
  echo "=> No Ruby yet, ruby-lsp not installed."
fi

echo
echo "================="
echo "Claude settings..."
echo "================="
# User settings of Claude Code in the container (CLAUDE_CONFIG_DIR, under tmp/):
# no attribution in commits and pull requests. Merged, other settings are kept.
settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
mkdir -p "$(dirname "$settings")"
[ -s "$settings" ] || echo '{}' > "$settings"
jq '.attribution = {"commit": "", "pr": "", "sessionUrl": false}' "$settings" > "$settings.tmp" \
  && mv "$settings.tmp" "$settings"
echo "=> Claude settings updated."

echo
echo "================="
echo "Install claude plugins..."
echo "================="
claude plugin marketplace add anthropics/claude-plugins-official || true
claude plugin marketplace add lucianghinda/superpowers-ruby --scope project
claude plugin marketplace add codecloud-sh/claude-plugins --scope project
claude plugin marketplace add JuliusBrussee/caveman

claude plugin install stack-rails@codecloud --scope project
claude plugin install ruby-lsp@claude-plugins-official --scope project \
  || echo "=> ruby-lsp plugin not installed."
claude plugin install caveman@caveman --scope project --yes

# Auto-update of the codecloud marketplace: off by default for a third-party
# marketplace. On, Claude Code refreshes it in the background during sessions.
project_settings=.claude/settings.json
jq '.extraKnownMarketplaces.codecloud.autoUpdate = true' "$project_settings" > "$project_settings.tmp" \
  && mv "$project_settings.tmp" "$project_settings"
echo "=> Claude plugins installation completed."

echo
echo "================="
echo "Running setup script..."
echo "================="
if [ -x bin/setup ]; then
  bin/setup --skip-server
else
  echo "=> No bin/setup yet (app not created?), skipping."
fi
echo "post-create.sh completed."
