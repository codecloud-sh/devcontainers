// Généré avec nicolascochin/devcontainers (Copier). Pour le mettre à jour :
//   uvx copier update -a .devcontainer/.copier-answers.yml
// Format : https://containers.dev/implementors/json_reference/
{
  "name": "{{ project_name }}",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/{{ project_slug }}",
  // Features : https://containers.dev/features
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
{%- if kamal %}
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
{%- endif %}
{%- if database == "sqlite3" %}
    "ghcr.io/rails/devcontainer/features/sqlite3": {},
{%- elif database == "postgresql" %}
    "ghcr.io/rails/devcontainer/features/postgres-client": {},
{%- elif database == "mysql" %}
    "ghcr.io/rails/devcontainer/features/mysql-client": {},
{%- endif %}
    "ghcr.io/jsburckhardt/devcontainer-features/rtk:1": {}
  },
  "containerEnv": {
    "MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS": "ruby,node",
{%- if system_tests %}
    "CAPYBARA_SERVER_PORT": "45678",
    "SELENIUM_HOST": "selenium",
{%- endif %}
{%- if kamal %}
    "KAMAL_REGISTRY_PASSWORD": "$KAMAL_REGISTRY_PASSWORD",
{%- endif %}
{%- if database == "postgresql" %}
    "DB_HOST": "postgres",
{%- elif database == "mysql" %}
    "DB_HOST": "mysql",
{%- endif %}
{%- if redis %}
    "REDIS_URL": "redis://redis:6379/1",
{%- endif %}
    "VISUAL": "code --wait",
    "CLAUDE_CONFIG_DIR": "${containerWorkspaceFolder}/tmp/claude",
    "GH_CONFIG_DIR": "${containerWorkspaceFolder}/tmp/gh",
    "PROTON_PASS_SESSION_DIR": "${containerWorkspaceFolder}/tmp/proton-pass",
    "PROTON_PASS_KEY_PROVIDER": "env",
    "PROTON_PASS_ENCRYPTION_KEY": "${localEnv:PROTON_PASS_ENCRYPTION_KEY}",
    "CAVEMAN_DEFAULT_MODE": "full"
  },
  // Ports du conteneur accessibles en local
  "forwardPorts": [
    3000, // Rails
{%- if database == "postgresql" %}
    5432, // PostgreSQL
{%- elif database == "mysql" %}
    3306, // MySQL
{%- endif %}
{%- if redis %}
    6379, // Redis
{%- endif %}
    8592 // Serveur de dev Herb (barre d'outils ReActionView)
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "bradlc.vscode-tailwindcss",
        "Anthropic.claude-code",
        "marcoroth.herb-lsp",
        "shanehofstetter.rails-i18n"
      ],
      "settings": {
        "rubyLsp.rubyVersionManager": {
          "miseExecutablePath": "/home/{{ username }}/.local/bin/mise",
          "identifier": "auto"
        },
        "git.detectWorktrees": true,
        "git.worktreeIncludeFiles": [
          "config/master.key",
          ".env*"
        ]
      }
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
