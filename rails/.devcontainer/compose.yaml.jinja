name: "{{ project_slug }}"

services:
  rails-app:
    build:
      context: ..
      dockerfile: .devcontainer/Dockerfile
    hostname: {{ project_slug }}

    volumes:
    - ..:/workspaces/{{ project_slug }}:cached
    # Ruby, Node ou Bun et gems installés par mise : gardés d'une reconstruction à l'autre
    - mise-data:/home/{{ username }}/.local/share/mise
    # Connexion de gh : un seul jeton par machine, partagé par tous les projets
    - gh-config:/home/{{ username }}/.config/gh

    # Garde le conteneur en vie quand aucun processus ne tourne
    command: sleep infinity
    # PID 1 qui transmet les signaux (arrêt immédiat) et récolte les processus zombies
    init: true

    # Pour exposer un port, utiliser "forwardPorts" dans devcontainer.json
{%- if system_tests or redis or database != "sqlite3" %}
    depends_on:
{%- if system_tests %}
    - selenium
{%- endif %}
{%- if redis %}
    - redis
{%- endif %}
{%- if database == "postgresql" %}
    - postgres
{%- elif database == "mysql" %}
    - mysql
{%- endif %}
{%- endif %}
{%- if system_tests %}

  selenium:
    image: selenium/standalone-chromium
    restart: unless-stopped
    environment:
      # Jusqu'à 4 navigateurs en parallèle (1 par défaut), même avec moins de processeurs
      SE_NODE_MAX_SESSIONS: '4'
      SE_NODE_OVERRIDE_MAX_SESSIONS: 'true'
    # /dev/shm fait 64 Mo par défaut : trop peu pour Chrome
    shm_size: 2gb
{%- endif %}
{%- if redis %}

  redis:
    image: valkey/valkey:9
    restart: unless-stopped
    volumes:
    - redis-data:/data
{%- endif %}
{%- if database == "postgresql" %}

  postgres:
    image: postgres:18
    restart: unless-stopped
    volumes:
    - postgres-data:/var/lib/postgresql
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
{%- elif database == "mysql" %}

  mysql:
    image: mysql:9.7
    restart: unless-stopped
    volumes:
    - mysql-data:/var/lib/mysql
    environment:
      MYSQL_ALLOW_EMPTY_PASSWORD: "true"
      MYSQL_ROOT_HOST: "%"
{%- endif %}

volumes:
  mise-data:
  # Nom fixe, sans le préfixe du projet compose : le même volume pour tous les
  # projets de la machine, Rails comme Astro
  gh-config:
    name: devcontainers-gh
{%- if redis %}
  redis-data:
{%- endif %}
{%- if database == "postgresql" %}
  postgres-data:
{%- elif database == "mysql" %}
  mysql-data:
{%- endif %}
