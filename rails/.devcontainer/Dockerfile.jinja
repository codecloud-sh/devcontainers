FROM debian:stable-slim
ARG USERNAME={{ username }}
ARG USER_GID=1000
ARG USER_UID=1000

# Create the user
RUN groupadd --gid $USER_GID $USERNAME \
  && apt-get update \
  && apt-get install -y sudo zsh curl \
  && useradd --uid $USER_UID --gid $USER_GID -m  -s /bin/zsh $USERNAME \
  # Add sudo support
  && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
  && chmod 0440 /etc/sudoers.d/$USERNAME \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Install required packages for Ruby development
# (Ruby itself is installed by mise in post-create.sh, from .ruby-version)
RUN apt-get update \
  && apt-get install -y  \
  git \
  openssh-client \
  build-essential \
  # fiddle
  libffi-dev \
  # psych
  libyaml-dev \
  # zlib
  zlib1g-dev \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

ENV HOME=/home/$USERNAME

USER $USERNAME

ENV PATH="$HOME/.local/bin:$PATH"
