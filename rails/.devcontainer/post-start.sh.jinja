#!/usr/bin/env bash
# Run at each start of the container: brings the plugins of the codecloud and
# rubypowers marketplaces up to date before any Claude Code session opens.
# During a session, the marketplace auto-update (set by post-create.sh) takes over.
# Never blocks the start: a failure is only reported.

echo "Update Claude plugins (codecloud, rubypowers)..."
if ! command -v claude >/dev/null 2>&1; then
  echo "=> claude not installed yet, skipping."
  exit 0
fi

for marketplace in codecloud rubypowers; do
  claude plugin marketplace update "$marketplace" || echo "=> $marketplace marketplace not refreshed."
done
for plugin in codecloud-core@codecloud stack-rails@codecloud rubypowers@rubypowers; do
  claude plugin update "$plugin" || echo "=> $plugin not updated."
done
echo "=> Claude plugins up to date."
exit 0
